DEPLOYFORGE_APP_ENV=development
DEPLOYFORGE_RUNTIME_ROLE=api
DEPLOYFORGE_LOG_LEVEL=INFO
# Production requires a PostgreSQL URL, HTTPS frontend/OIDC URLs, and secure cookies.
DEPLOYFORGE_SESSION_SECRET=
DEPLOYFORGE_SESSION_COOKIE_SECURE=false
DEPLOYFORGE_FRONTEND_BASE_URL=http://localhost:5173
DEPLOYFORGE_DEV_AUTH_ENABLED=true
DEPLOYFORGE_DEV_AUTH_AUTO_ADMIN_FIRST_USER=true
# Optional OIDC provider (for example, an enterprise identity provider discovery URL).
DEPLOYFORGE_OIDC_DISCOVERY_URL=
DEPLOYFORGE_OIDC_CLIENT_ID=
DEPLOYFORGE_OIDC_CLIENT_SECRET=
DEPLOYFORGE_OIDC_REDIRECT_URI=
DEPLOYFORGE_OIDC_ADMIN_EMAILS=
DEPLOYFORGE_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
DEPLOYFORGE_WORKER_HEARTBEAT_STALE_AFTER_SECONDS=30
DEPLOYFORGE_TELEMETRY_RETENTION_DAYS=31
# Optional OpenTelemetry Collector OTLP/HTTP endpoint, for example http://otel-collector:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Optional GitHub Actions build provider. Keep these values in a secret manager in production.
# The callback URL must be HTTPS and reachable by GitHub-hosted/self-hosted runners.
DEPLOYFORGE_GITHUB_ACTIONS_TOKEN=
DEPLOYFORGE_GITHUB_API_URL=https://api.github.com
DEPLOYFORGE_GITHUB_ACTIONS_WORKFLOW_PATH=.github/workflows/deployforge-build.yml
DEPLOYFORGE_INFRASTRUCTURE_WORKFLOW_PATH=.github/workflows/deployforge-infrastructure.yml
DEPLOYFORGE_BUILD_CALLBACK_SECRET=
DEPLOYFORGE_BUILD_CALLBACK_PUBLIC_URL=
DEPLOYFORGE_BUILD_CALLBACK_TIMEOUT_SECONDS=14400
DEPLOYFORGE_BUILD_MAX_CRITICAL_VULNERABILITIES=0
DEPLOYFORGE_BUILD_MAX_HIGH_VULNERABILITIES=0
# Optional Argo CD provider. The API URL must use HTTPS; TLS verification remains enabled.
DEPLOYFORGE_ARGOCD_API_URL=
DEPLOYFORGE_ARGOCD_AUTH_TOKEN=
DEPLOYFORGE_ARGOCD_API_TIMEOUT_SECONDS=15
DEPLOYFORGE_GITOPS_SYNC_TIMEOUT_SECONDS=1800
DEPLOYFORGE_GITOPS_RECONCILE_INTERVAL_SECONDS=10

