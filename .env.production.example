# Copy to .env.production and set values for the HTTPS hostname exposed by your reverse proxy.
DEPLOYFORGE_FRONTEND_BASE_URL=https://deployforge.example.com
DEPLOYFORGE_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
DEPLOYFORGE_OIDC_CLIENT_ID=deployforge
DEPLOYFORGE_OIDC_REDIRECT_URI=https://deployforge.example.com/api/v1/auth/callback
DEPLOYFORGE_OIDC_ADMIN_EMAILS=platform-admin@example.com
DEPLOYFORGE_REQUIRE_VERIFIED_APPROVAL_IDENTITY=true

# Set only after the runner can reach the signed callback endpoint over HTTPS.
# Select github_actions, gitlab_ci, or azure_devops. Keep provider credentials in the worker's secret mount.
DEPLOYFORGE_BUILD_PROVIDER=github_actions
DEPLOYFORGE_BUILD_CALLBACK_PUBLIC_URL=https://deployforge.example.com
DEPLOYFORGE_GITLAB_SERVER_URL=
DEPLOYFORGE_GITLAB_API_URL=
DEPLOYFORGE_GITLAB_CI_CONFIG_PATH=.gitlab-ci.yml
# When selected, put the GitLab project/group API token in secrets/gitlab_build_token.
DEPLOYFORGE_AZURE_DEVOPS_ORGANIZATION_URL=
DEPLOYFORGE_AZURE_DEVOPS_OIDC_ISSUER=
DEPLOYFORGE_AZURE_DEVOPS_PIPELINE_IDS={}
# When selected, put the short-lived, Build Execute-scoped token in secrets/azure_devops_build_token.
DEPLOYFORGE_SIGSTORE_TRUSTED_ROOT_FILE=
DEPLOYFORGE_SIGSTORE_TRUSTED_ROOT_SHA256=
DEPLOYFORGE_APK_PARSER_URL=
DEPLOYFORGE_APK_PARSER_TIMEOUT_SECONDS=120
DEPLOYFORGE_GITHUB_ACTIONS_WORKFLOW_PATH=.github/workflows/deployforge-build.yml
DEPLOYFORGE_INFRASTRUCTURE_WORKFLOW_PATH=.github/workflows/deployforge-infrastructure.yml
DEPLOYFORGE_GITHUB_SERVER_URL=https://github.com

# Leave blank until a trusted Argo CD endpoint and scoped token are available.
DEPLOYFORGE_ARGOCD_API_URL=
DEPLOYFORGE_ARGO_ROLLOUTS_API_URL=
# Optional Flux API endpoint and stable cluster identity; token belongs in
# secrets/flux_auth_token and is mounted only into the worker.
DEPLOYFORGE_FLUX_API_URL=
DEPLOYFORGE_FLUX_CLUSTER_NAME=
DEPLOYFORGE_FLUX_API_TIMEOUT_SECONDS=15
DEPLOYFORGE_GITHUB_REPOSITORY_OWNER=
DEPLOYFORGE_GITHUB_REPOSITORY_TEMPLATES={}
DEPLOYFORGE_GITHUB_REPOSITORY_PRIVATE=true
# The production Compose overlay mounts secrets/github_repository_token for the worker.
# Create an empty file while disabled; add its scoped token to enable repository bootstrap.
# When enabled, the worker also reads secrets/build_callback_secret to bootstrap CI.
DEPLOYFORGE_GITHUB_API_URL=https://api.github.com
DEPLOYFORGE_REQUIRE_VERIFIED_SUPPLY_CHAIN=true
DEPLOYFORGE_SIGSTORE_OIDC_ISSUER=https://token.actions.githubusercontent.com
# For a private Sigstore instance, set the path /run/secrets/sigstore_trusted_root.json and pin its SHA-256.
# Azure DevOps requires a private Fulcio identity mapping and this checksum-pinned custom root.
DEPLOYFORGE_SIGSTORE_TRUSTED_ROOT_FILE=
DEPLOYFORGE_SIGSTORE_TRUSTED_ROOT_SHA256=
DEPLOYFORGE_BUILD_MAX_CRITICAL_VULNERABILITIES=0
DEPLOYFORGE_BUILD_MAX_HIGH_VULNERABILITIES=0
