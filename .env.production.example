# Copy to .env.production and set values for the HTTPS hostname exposed by your reverse proxy.
DEPLOYFORGE_FRONTEND_BASE_URL=https://deployforge.example.com
DEPLOYFORGE_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
DEPLOYFORGE_OIDC_CLIENT_ID=deployforge
DEPLOYFORGE_OIDC_REDIRECT_URI=https://deployforge.example.com/api/v1/auth/callback
DEPLOYFORGE_OIDC_ADMIN_EMAILS=platform-admin@example.com

# Set only after the runner can reach the signed callback endpoint over HTTPS.
# Enable GitHub dispatch by adding its token to secrets/github_actions_token.
DEPLOYFORGE_BUILD_CALLBACK_PUBLIC_URL=https://deployforge.example.com
DEPLOYFORGE_GITHUB_ACTIONS_WORKFLOW_PATH=.github/workflows/deployforge-build.yml
DEPLOYFORGE_INFRASTRUCTURE_WORKFLOW_PATH=.github/workflows/deployforge-infrastructure.yml

# Leave blank until a trusted Argo CD endpoint and scoped token are available.
DEPLOYFORGE_ARGOCD_API_URL=
DEPLOYFORGE_GITHUB_API_URL=https://api.github.com
DEPLOYFORGE_REQUIRE_VERIFIED_SUPPLY_CHAIN=true
DEPLOYFORGE_BUILD_MAX_CRITICAL_VULNERABILITIES=0
DEPLOYFORGE_BUILD_MAX_HIGH_VULNERABILITIES=0
